 namespace {
 
+#if defined(INFERNO_BENCH_PMU_TRACKS)
+// Hardware counter tracks attached to every event on a thread's own track,
+// next to thread time. "thread_instruction_count" is the name trace_processor
+// maps to slice.thread_instruction_delta; the others are generic incremental
+// counter tracks queried from the counter table.
+CounterTrack InfernoBenchCounterTrack(int i, const ThreadTrack& parent) {
+  switch (i) {
+    case 0:
+      return CounterTrack("thread_instruction_count", parent)
+          .set_is_incremental(true)
+          .set_type(
+              protos::gen::CounterDescriptor::COUNTER_THREAD_INSTRUCTION_COUNT);
+    case 1:
+      return CounterTrack("inferno_bench.cycles", parent).set_is_incremental(true);
+    case 2:
+      return CounterTrack("inferno_bench.branch_misses", parent)
+          .set_is_incremental(true);
+    default:
+      return CounterTrack("inferno_bench.l1d_read_misses", parent)
+          .set_is_incremental(true);
+  }
+}
+
+// Last absolute counter values per thread, for per-event deltas.
+struct InfernoBenchLast {
+  bool valid = false;
+  uint64_t values[inferno_bench::kNumCounters] = {};
+};
+
+InfernoBenchLast& InfernoBenchLastValues() {
+  thread_local InfernoBenchLast last;
+  return last;
+}
+#endif  // defined(INFERNO_BENCH_PMU_TRACKS)
